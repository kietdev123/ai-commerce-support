# Phase 2 local AI ports
OLLAMA_PORT=11434
DIFY_PORT=3000
DIFY_SSL_PORT=3443

# Comma-separated models pulled automatically on first startup.
OLLAMA_MODELS=qwen3:1.7b,llama3.2:1b
OLLAMA_DEFAULT_MODEL=qwen3:1.7b

# Server-side key of the published Dify app. Never expose it as NEXT_PUBLIC_*.
DIFY_API_KEY=
